# Copy to .env and edit before running.
# On Linux the Teensy usually appears as /dev/ttyACM0 or /dev/ttyUSB0.
# On Windows: COM3, COM4, etc.  On macOS: /dev/cu.usbmodem*

SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200

# Host/ports for the FastAPI server.
# Use 0.0.0.0 to accept connections from other devices on your network
# (required for phone access).
# Defaults serve HTTPS on 443 and an HTTP->HTTPS redirect on 80, so a phone
# connects with just the IP (e.g. https://192.168.1.50, no port).
HOST=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80
